# =============================================================================
#  CUSTOMER CONFIG — terraform/envs/prod/terraform.tfvars
# =============================================================================
#  HOW TO USE THIS FILE
#
#    cp terraform.tfvars.example terraform.tfvars
#    $EDITOR terraform.tfvars
#    # fill in sections marked [REQUIRED]
#    # optionally change sections marked [RECOMMENDED]
#    # leave [OPTIONAL] alone unless you have a specific reason
#
#  Tags used in this template:
#    [REQUIRED]     must change before apply — defaults are placeholders
#    [RECOMMENDED]  strongly suggest changing to your own values
#    [OPTIONAL]     commented out; defaults in variables.tf are fine for MVP
#
#  `terraform.tfvars` is gitignored — your real values stay out of git.
# =============================================================================


# =============================================================================
#  [REQUIRED]  VPC + subnets — fill these in
# =============================================================================

# [REQUIRED] CHANGE THIS — Existing VPC ID in your AWS account.
# The stack does NOT create a VPC. CIDR is auto-discovered.
vpc_id = "vpc-XXXXXXXXXXXXXXXXX"

# [REQUIRED] CHANGE THIS — 2+ private subnet IDs, cross 2 AZs.
# Keys (az1a / az1c) are logical names — change them if you want.
# Rule: every subnet_key below (in keeper_placement etc) must exist in this map.
#
# Each subnet MUST be able to reach SSM, via either:
#   a) NAT Gateway (simplest, costs ~$45/mo per NAT)
#   b) VPC interface endpoints for ssm/ssmmessages/ec2messages (more secure, cheaper)
private_subnet_ids = {
  "az1a" = "subnet-XXXXXXXXXXXXXXXXX"
  "az1c" = "subnet-XXXXXXXXXXXXXXXXX"
}


# =============================================================================
#  [RECOMMENDED]  Region + AWS profile
# =============================================================================

# [RECOMMENDED] CHANGE THIS — AWS region. Default ap-northeast-1 (Tokyo).
# Common values: ap-northeast-1, us-west-2, us-east-1, eu-west-1, ap-southeast-1.
region = "ap-northeast-1"

# [RECOMMENDED] CHANGE THIS — AWS profile name from ~/.aws/credentials.
# "default" works for most single-account setups. Pin explicitly so scripts
# behave the same as interactive runs (avoids AWS_PROFILE env var confusion).
profile = "default"


# =============================================================================
#  [RECOMMENDED]  Identity / naming
# =============================================================================

# [RECOMMENDED] CHANGE THIS — Prefix on every named resource (IAM roles, SGs,
# NLB, EventBridge rules, default S3 bucket). IAM role and bucket names are
# globally scoped, so multi-tenant accounts MUST use different prefixes.
# Examples: "acme-ck", "ctrip-ck", "shennong-ck".
name_prefix = "zeelool-ck"

# [RECOMMENDED] CHANGE THIS — ClickHouse internal cluster identifier.
# Appears in remote_servers.xml and system.clusters. Must be ASCII [a-z0-9_],
# NO HYPHENS (ClickHouse limitation). Often: name_prefix with "-" → "_".
cluster_name = "zeelool_ck"


# =============================================================================
#  [OPTIONAL]  Tagging — only if you have specific compliance tags
# =============================================================================

# owner       = "data-platform"
# environment = "prod"
# extra_tags  = { CostCenter = "analytics", Compliance = "none" }


# =============================================================================
#  [OPTIONAL]  Topology — defaults work for 2-AZ setups
# =============================================================================

# DEFAULT = 2-AZ asymmetric (2 Keepers in az1a, 1 in az1c).
# Fault tolerance: lose az1c → OK (2/3 quorum). Lose az1a → cluster READ-ONLY.
#
# UNCOMMENT + MODIFY only if you need 3-AZ symmetric FT, or want different
# replica / keeper counts.

# keeper_placement = {
#   "keeper-01" = { subnet_key = "az1a", server_id = 1 }
#   "keeper-02" = { subnet_key = "az1a", server_id = 2 }
#   "keeper-03" = { subnet_key = "az1c", server_id = 3 }
# }

# FOR 3-AZ SYMMETRIC FT (any 1 AZ can fail) — requires 3 subnets above:
# private_subnet_ids = {
#   "az1a" = "subnet-..."
#   "az1c" = "subnet-..."
#   "az1d" = "subnet-..."
# }
# keeper_placement = {
#   "keeper-01" = { subnet_key = "az1a", server_id = 1 }
#   "keeper-02" = { subnet_key = "az1c", server_id = 2 }
#   "keeper-03" = { subnet_key = "az1d", server_id = 3 }
# }

# clickhouse_placement = {
#   "ck-01" = { subnet_key = "az1a" }
#   "ck-02" = { subnet_key = "az1c" }
# }


# =============================================================================
#  [OPTIONAL]  Private IPs — auto-computed from subnet CIDRs by default
# =============================================================================

# Default auto-offset: Keeper = subnet+100, CK = subnet+200 (e.g. 10.0.11.100 / .200).
# Multiple keepers in same subnet get +1 per index automatically (100, 101, ...).
# Only set these if your subnet has workloads at those offsets.

# keeper_ip_host_offset     = 100
# clickhouse_ip_host_offset = 200


# =============================================================================
#  [OPTIONAL]  Instance sizing — defaults fit 100-500M rows/day workloads
# =============================================================================

# Keeper — t4g.small handles Raft for <50 replicated tables. Upshift only if
# you run many replicated tables or very high mutation rates.
# keeper_instance_type = "t4g.small"

# ClickHouse — r8g (Graviton4, 8 GB/vCPU ratio CK recommends for warehousing).
# Options (Tokyo on-demand / month / node):
#   r8g.large     (2 vCPU / 16 GB)  ~$95   — MVP / <100M rows/day
#   r8g.xlarge    (4 vCPU / 32 GB)  ~$208  — default, 100M-500M rows/day
#   r8g.2xlarge   (8 vCPU / 64 GB)  ~$416  — heavy BI, >500M rows/day
# DO NOT use m8g — 4 GB/vCPU is too tight; r8g.large = 16 GB is the floor.
# clickhouse_instance_type = "r8g.xlarge"


# =============================================================================
#  [OPTIONAL]  EBS data volume — 1500 GB gp3 default, online-expandable
# =============================================================================

# Per-node data volume size. Expand online via SSM doc resize-data-volume.
# ⚠ size / iops / throughput each have an AWS 6-hour cooldown. If you're
#    changing multiple attrs, submit them in ONE apply.
# clickhouse_data_volume_gb              = 1500
# clickhouse_data_volume_iops            = 4500  # 3000-16000 (default baseline 3000)
# clickhouse_data_volume_throughput_mbps = 250   # 125-1000   (default baseline 125)


# =============================================================================
#  [OPTIONAL]  SSH access — SSM Session Manager covers 90% of use cases
# =============================================================================

# Attach EC2 KeyPair for SSH. null = no key, rely on SSM Session Manager (safer).
# The .pem file MUST live outside this repo — commit only the AWS KeyPair NAME.
# Retrofit a key to running nodes: scripts/install-ssh-public-key.sh <pem-path>
# ssh_key_name = "my-ec2-keypair"


# =============================================================================
#  [OPTIONAL]  Backup
# =============================================================================

# Bucket name — empty auto-names as <name_prefix>-backup-<account>-<region>
# which is globally unique by construction. Pin if you have a naming convention.
# backup_bucket_name = "acme-ck-backup"

# SNS topic for backup-failure alarms. 3 CW alarms publish here if set.
# Empty = alarms exist silent (visible in CW console, no paging).
# Wire to PagerDuty / Slack / email SNS sink once on-call is set up.
# backup_alarm_sns_topic_arn = "arn:aws:sns:<region>:<account>:acme-ck-oncall"
