# =============================================================================
#  BOOTSTRAP CONFIG — terraform/bootstrap/terraform.tfvars
# =============================================================================
#  Creates the Terraform state backend: S3 bucket + S3 native locking
#  (no DynamoDB — uses use_lockfile=true, Terraform 1.10+).
#
#  HOW TO USE THIS FILE
#
#    cp terraform.tfvars.example terraform.tfvars
#    $EDITOR terraform.tfvars
#    terraform init && terraform apply
#    terraform output -raw backend_hcl > ../envs/prod/backend.hcl
#
#  Tags used in this template:
#    [RECOMMENDED]  strongly suggest changing to your own values
#    [OPTIONAL]     commented out; defaults fine for most MVP deploys
#
#  This module has NO [REQUIRED] fields — every var has a default.
#  But for a real customer deploy you'll almost always set region + profile.
# =============================================================================


# =============================================================================
#  [RECOMMENDED]  Region + AWS profile
# =============================================================================

# [RECOMMENDED] CHANGE THIS — Must match envs/prod region (cross-region backend
# works but adds latency + transfer cost). Common: ap-northeast-1, us-west-2.
region = "ap-northeast-1"

# [RECOMMENDED] CHANGE THIS — AWS profile name. "default" works for most.
# Pin explicitly so running the deploy.sh under a stale AWS_PROFILE=<other>
# env var doesn't target the wrong account.
profile = "default"


# =============================================================================
#  [OPTIONAL]  Naming — defaults match envs/prod tfvars, keep aligned
# =============================================================================

# Tag prefix + default bucket/table name prefix. Align with envs/prod
# `name_prefix`. Default produces:
#   bucket : zeelool-ck-tfstate-<region>      (globally unique)
# name_prefix = "zeelool-ck"

# Override bucket name if your org has a naming convention or the default
# collides with another project in the same global S3 namespace.
# state_bucket_name = "acme-ck-tfstate-prod"

# Owner tag — propagates to Project/Owner tags on the state bucket.
# owner = "data-platform"
