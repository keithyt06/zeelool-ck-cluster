<clickhouse>
    <users>
        <!-- replace="1" — don't merge with the base users.xml's empty <password></password>.
             Without this CH 25+ errors with "More than one field of 'password', 'password_sha256_hex'...
             used to specify authentication info for user default" at startup. -->
        <default replace="1">
            <password_sha256_hex>${default_password_sha256}</password_sha256_hex>
            <networks>
                <ip>10.0.0.0/16</ip>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <!-- access_management=1 lets `default` run CREATE USER / GRANT / DROP USER at
                 runtime. New users + grants persist in SQL-managed storage (see
                 access-control.xml → user_directories.replicated), not in XML.
                 Treat `default` as your "root" account — everything else via SQL. -->
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
    </users>
</clickhouse>
